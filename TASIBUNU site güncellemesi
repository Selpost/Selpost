/* =====================================================
   HTML GÜVENLİ ÇIKIŞ
===================================================== */

function esc(value){

  return String(value ?? "")
    .replace(/[&<>"']/g,function(m){

      return {
        "&":"&amp;",
        "<":"&lt;",
        ">":"&gt;",
        '"':"&quot;",
        "'":"&#039;"
      }[m];

    });

}


/* =====================================================
   ARAMA NORMALİZASYONU
===================================================== */

function norm(value){

  return String(value ?? "")
    .toLocaleLowerCase("tr-TR");

}


/* =====================================================
