/* =====================================================
   İLAN DÜZENLE
===================================================== */

function editIlan(id){

  const x=
    ilanlar.find(function(i){

      return String(i.id) ===
        String(id);

    });


  if(!x)return;


  document.getElementById(
    "editId"
  ).value=x.id;


  document.getElementById(
    "editKategori"
  ).value=
    x.kategori || "Diğer";


  document.getElementById(
    "editYuk"
  ).value=
    x.yuk_tipi ||
    x.yuk_turu ||
    "";


  document.getElementById(
    "editArac"
  ).value=
    x.arac_tipi ||
    "Panelvan";


  document.getElementById(
    "editTasima"
  ).value=
    x.tasima_tipi ||
    "Şehir içi";


  document.getElementById(
    "editFrom"
  ).value=
    x.nereden || "";


  document.getElementById(
    "editTo"
  ).value=
    x.nereye || "";


  document.getElementById(
    "editDesc"
  ).value=
    x.aciklama || "";


  openModal(
    "editModal"
  );

}


/* =====================================================
   GÜNCELLE
===================================================== */

document
  .getElementById("editForm")
  .addEventListener(
    "submit",
    async function(e){

      e.preventDefault();


      const id=
        document.getElementById(
          "editId"
        ).value;


      const {error}=
        await supabaseClient
          .from("ilanlar")
          .update({

            kategori:
              document.getElementById(
                "editKategori"
              ).value,

            yuk_tipi:
              document.getElementById(
                "editYuk"
              ).value.trim(),

            arac_tipi:
              document.getElementById(
                "editArac"
              ).value,

            tasima_tipi:
              document.getElementById(
                "editTasima"
              ).value,

            nereden:
              document.getElementById(
                "editFrom"
              ).value.trim(),

            nereye:
              document.getElementById(
                "editTo"
              ).value.trim(),

            aciklama:
              document.getElementById(
                "editDesc"
              ).value.trim()

          })
          .eq(
            "id",
            id
          );


      if(error){

        message(
          "editMsg",
          "Güncelleme başarısız: "+
          error.message,
          "danger"
        );

        return;

      }


      closeModal(
        "editModal"
      );

      await loadAll();

    }
  );


/* =====================================================
   SİL
===================================================== */

async function deleteIlan(id){

  if(
    !confirm(
      "Bu ilanı silmek istediğine emin misin?"
    )
  ){

    return;

  }


  const {error}=
    await supabaseClient
      .from("ilanlar")
      .delete()
      .eq(
        "id",
        id
      );


  if(error){

    alert(
      "Silinemedi: "+
      error.message
    );

    return;

  }


  await loadAll();

}


