}


/* =====================================================
   WHATSAPP
===================================================== */

function whatsapp(phone){

  const digits=
    String(phone || "")
      .replace(/\D/g,"");

  if(!digits)return "#";

  const tr=
    digits.startsWith("0")
      ? "90"+digits.slice(1)
      : digits;

  return "https://wa.me/"+tr;

}


/* =====================================================
   TÜRKİYE KONUM VERİLERİNİ YÜKLE
===================================================== */

async function loadLocationData(){

  try{

    const response=
      await fetch(
        LOCATION_API+"/provinces"
      );

    if(!response.ok){

      throw new Error(
        "İller alınamadı."
      );

    }

    const result=
      await response.json();

    provinces=
      result.data || [];

    const districtResponse=
      await fetch(
        LOCATION_API+"/districts"
      );

    if(!districtResponse.ok){

      throw new Error(
        "İlçeler alınamadı."
      );

    }

    const districtResult=
      await districtResponse.json();

    districts=
      districtResult.data || [];

    locationReady=true;

    fillProvinceSelects();

  }catch(error){

    console.error(
      "Konum verileri:",
      error
    );

    const note=
      document.getElementById(
        "locationInfo"
      );

    if(note){

      note.innerHTML=
        "Konum verileri yüklenemedi. Sayfayı yenileyin.";

    }

  }

}


/* =====================================================
   İLLERİ SELECTLERE DOLDUR
===================================================== */

function fillProvinceSelects(){

  const ids=[
    "nereden_il",
    "nereye_il",
    "nak_sehir"
  ];

  ids.forEach(function(id){

    const select=
      document.getElementById(id);

    if(!select)return;

    const first=
      select.options[0]
        ? select.options[0].outerHTML
        : "";

    select.innerHTML=first;

    provinces
      .slice()
      .sort(function(a,b){

        return a.name.localeCompare(
          b.name,
          "tr"
        );

      })
      .forEach(function(province){

        const option=
          document.createElement(
            "option"
          );

        option.value=
          province.id;

        option.textContent=
          province.name;

        select.appendChild(option);

      });

  });

}


/* =====================================================
   İLÇELERİ GETİR
===================================================== */

function getDistrictsForProvince(
  provinceId
){

  return districts
    .filter(function(d){

      return String(d.provinceId) ===
        String(provinceId);

    })
    .sort(function(a,b){

      return a.name.localeCompare(
        b.name,
        "tr"
      );

    });

}


/* =====================================================
   İLÇE SELECT DOLDUR
===================================================== */

function fillDistrictSelect(
  selectId,
  provinceId
){

  const select=
    document.getElementById(
      selectId
    );

  if(!select)return;

  select.innerHTML=
    `<option value="">İlçe seçin</option>`;

  if(!provinceId){

    select.innerHTML=
      `<option value="">Önce il seçin</option>`;

    return;

  }

  const list=
    getDistrictsForProvince(
      provinceId
    );

  list.forEach(function(district){

    const option=
      document.createElement(
        "option"
      );

    option.value=
      district.id;

    option.textContent=
      district.name;

    select.appendChild(option);

  });

}


/* =====================================================
   MAHALLELERİ GETİR
===================================================== */

async function loadNeighborhoods(
  districtId,
  selectId
){

  const select=
    document.getElementById(
      selectId
    );

  if(!select)return;

  select.innerHTML=
    `<option value="">Mahalleler yükleniyor...</option>`;

  if(!districtId){

    select.innerHTML=
      `<option value="">Önce ilçe seçin</option>`;

    return;

  }

  try{

    const response=
      await fetch(
        LOCATION_API+
        "/districts/"+
        districtId
      );

    if(!response.ok){

      throw new Error(
        "Mahalleler alınamadı."
      );

    }

    const result=
      await response.json();

    const data=
      result.data || {};

    const neighborhoods=
      data.neighborhoods || [];

    select.innerHTML=
      `<option value="">Mahalle seçin</option>`;

    neighborhoods
      .slice()
      .sort(function(a,b){

        return a.name.localeCompare(
          b.name,
          "tr"
        );

      })
      .forEach(function(neighborhood){

        const option=
          document.createElement(
            "option"
          );

        option.value=
          neighborhood.id;

        option.textContent=
          neighborhood.name;

        select.appendChild(option);

      });

  }catch(error){

    console.error(error);

    select.innerHTML=
      `<option value="">Mahalleler yüklenemedi</option>`;

  }

}


/* =====================================================
   İL ADINI BUL
===================================================== */

function provinceName(id){

  const p=
    provinces.find(function(x){

      return String(x.id) ===
        String(id);

    });

  return p ? p.name : "";

}


/* =====================================================
   İLÇE ADINI BUL
===================================================== */

function districtName(id){

  const d=
    districts.find(function(x){

      return String(x.id) ===
        String(id);

    });

  return d ? d.name : "";

}


/* =====================================================
   MAHALLE ADINI SELECTTEN AL
===================================================== */

function selectedText(id){

  const el=
    document.getElementById(id);

  if(!el)return "";

  const option=
    el.options[el.selectedIndex];

  if(!option)return "";

  return option.value
    ? option.textContent
    : "";

}


