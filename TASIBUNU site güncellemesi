            ).value
          );

        nereyeIlce=
          districtName(
            document.getElementById(
              "nereye_ilce"
            ).value
          );

        nereyeMahalle=
          selectedText(
            "nereye_mahalle"
          );

      }


      const nereden=
        [
          neredenIl,
          neredenIlce,
          neredenMahalle
        ]
        .filter(Boolean)
        .join(" / ");


      const nereye=
        [
          nereyeIl,
          nereyeIlce,
          nereyeMahalle
        ]
        .filter(Boolean)
        .join(" / ");


      const row={

        owner_id:
          user?.id || null,

        kategori:
          document.getElementById(
            "kategori"
          ).value,

        yuk_tipi:
          document.getElementById(
            "yuk_tipi"
          ).value.trim(),

        tasima_tipi:
          tasimaTipi,

        nereden:
          nereden,

        nereye:
          nereye,

        arac_tipi:
          document.getElementById(
            "arac_tipi"
          ).value,

        tonaj:
          document.getElementById(
            "tonaj"
          ).value.trim(),

        tarih:
          document.getElementById(
            "tarih"
          ).value || null,

        telefon:
          document.getElementById(
            "telefon"
          ).value.trim(),

        aciklama:
          document.getElementById(
            "aciklama"
          ).value.trim()

      };


      const {error}=
        await supabaseClient
          .from("ilanlar")
          .insert(row);


      if(error){

        console.error(error);

        message(
          "ilanMsg",
          "İlan kaydedilemedi: "+
          error.message,
          "danger"
        );

        return;

      }


      message(
        "ilanMsg",
        "İlan başarıyla yayınlandı.",
        "success"
      );


      e.target.reset();

      setMinDate();

      resetLocationForm();

      await loadAll();


      setTimeout(function(){

        closeModal(
          "ilanModal"
        );

        message(
          "ilanMsg",
          ""
        );

      },700);

    }
  );


